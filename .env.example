# Providers are tried in this order; each one configured is a fallback for the one before it, so a
# rate-limited provider costs seconds instead of the run. All empty = retrieval-only baseline.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Omit QDRANT_URL to use the in-memory client (fine up to ~50k rulings).
QDRANT_URL=
QDRANT_API_KEY=
