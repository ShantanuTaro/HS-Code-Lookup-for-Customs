# Providers are tried in this order; each one configured is a fallback for the one before it, so a
# rate-limited provider costs seconds instead of the run. All empty = retrieval-only baseline.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest

# Omit QDRANT_URL to use embedded Qdrant on disk in data/qdrant/, which warns above ~20k
# points. Past that run a server and point at it; QDRANT_API_KEY is only for Qdrant Cloud.
#   docker run -d -p 6333:6333 -v "$PWD/data/qdrant-server:/qdrant/storage" qdrant/qdrant
QDRANT_URL=
QDRANT_API_KEY=
